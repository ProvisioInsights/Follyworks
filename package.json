{
  "name": "follyworks",
  "version": "0.1.0",
  "private": true,
  "description": "Follyworks: build the unnecessary. A contraption puzzle toy box.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "fun:audit": "vitest run --config vitest.fun.config.ts tools/fun/audit",
    "fun:playtests": "vitest run --config vitest.fun.config.ts tools/fun/playtests",
    "playtests:pull": "node tools/playtests/pull.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
