// Cloudflare deploy config: a Worker with no script that serves the Vite build in dist/ as
// static assets. Static asset requests are free and unlimited, so the game runs no Worker code.
// Deploy with `npm run deploy` after `npx wrangler login`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "follyworks",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
